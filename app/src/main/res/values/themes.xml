<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Record" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Record" parent="Base.Theme.Record" />

    <!-- 设置弹窗主题：弹窗背景与页面背景一致 -->
    <style name="ThemeOverlay.App.SettingsDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.App.Settings</item>
    </style>

    <!-- 弹窗背景直接取页面背景色，绕开 surface/tint 体系 -->
    <style name="MaterialAlertDialog.App.Settings" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?android:attr/colorBackground</item>
    </style>
</resources>